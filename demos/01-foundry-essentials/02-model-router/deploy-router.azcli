SUBSCRIPTION_ID="cd091145-5ea2-4703-ba5d-41063b1d4308"
RESOURCE_GROUP="rg-pro-code-agents"
RESOURCE_NAME="pro-code-agents-foundry"
API_VERSION="2025-10-01-preview"
BASE="https://management.azure.com/subscriptions/$SUBSCRIPTION_ID/resourceGroups/$RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/$RESOURCE_NAME/deployments"

az rest --method put --url "$BASE/m1-router-balanced?api-version=$API_VERSION" --body '{"sku":{"name":"GlobalStandard","capacity":10},"properties":{"model":{"format":"OpenAI","name":"model-router","version":"2025-11-18"}}}'

az rest --method put --url "$BASE/m1-router-quality?api-version=$API_VERSION" --body '{"sku":{"name":"GlobalStandard","capacity":10},"properties":{"model":{"format":"OpenAI","name":"model-router","version":"2025-11-18"},"routing":{"mode":"quality"}}}'

az rest --method put --url "$BASE/m1-router-cost?api-version=$API_VERSION" --body '{"sku":{"name":"GlobalStandard","capacity":10},"properties":{"model":{"format":"OpenAI","name":"model-router","version":"2025-11-18"},"routing":{"mode":"cost"}}}'

az rest --method put --url "$BASE/m1-router-subset?api-version=$API_VERSION" --body '{"sku":{"name":"GlobalStandard","capacity":10},"properties":{"model":{"format":"OpenAI","name":"model-router","version":"2025-11-18"},"routing":{"mode":"cost","models":[{"format":"OpenAI","name":"gpt-5-mini","version":"2025-08-07"},{"format":"OpenAI","name":"gpt-5.4","version":"2026-03-05"}]}}}'

az cognitiveservices account deployment list --resource-group $RESOURCE_GROUP --name $RESOURCE_NAME --query "[?starts_with(name,'m1-router')].{Name:name,Model:properties.model.name,Version:properties.model.version}" --output table
