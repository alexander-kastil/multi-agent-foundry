RESOURCE_GROUP="${RESOURCE_GROUP:-rg-pro-code-agents}"
ACCOUNT_NAME="${ACCOUNT_NAME:-pro-code-agents-foundry}"
SUBSCRIPTION_ID=$(az account show --query id -o tsv)
BASE="https://management.azure.com/subscriptions/$SUBSCRIPTION_ID/resourceGroups/$RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/$ACCOUNT_NAME/deployments"
API="api-version=2025-10-01-preview"

deploy_router() {
  az rest --method put --url "$BASE/$1?$API" --body "$2" \
    --query "{name:name, state:properties.provisioningState, routing:properties.routing}" -o json
}

deploy_router m1-router-balanced '{
  "sku": {"name": "GlobalStandard", "capacity": 10},
  "properties": {"model": {"format": "OpenAI", "name": "model-router", "version": "2025-11-18"}}
}'

deploy_router m1-router-quality '{
  "sku": {"name": "GlobalStandard", "capacity": 10},
  "properties": {
    "model": {"format": "OpenAI", "name": "model-router", "version": "2025-11-18"},
    "routing": {"mode": "quality"}
  }
}'

deploy_router m1-router-cost '{
  "sku": {"name": "GlobalStandard", "capacity": 10},
  "properties": {
    "model": {"format": "OpenAI", "name": "model-router", "version": "2025-11-18"},
    "routing": {"mode": "cost"}
  }
}'

deploy_router m1-router-subset '{
  "sku": {"name": "GlobalStandard", "capacity": 10},
  "properties": {
    "model": {"format": "OpenAI", "name": "model-router", "version": "2025-11-18"},
    "routing": {
      "mode": "balanced",
      "models": [
        {"format": "OpenAI", "name": "gpt-5-mini", "version": "2025-08-07"},
        {"format": "OpenAI", "name": "gpt-5.4", "version": "2026-03-05"}
      ]
    }
  }
}'
