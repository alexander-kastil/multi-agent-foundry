RESOURCE_GROUP="rg-pro-code-agents"
LOCATION="swedencentral"
FOUNDRY_ACCOUNT="pro-code-agents-foundry"
FOUNDRY_PROJECT="pro-code-agents"
SUBSCRIPTION_ID=$(az account show --query id -o tsv)

az monitor log-analytics workspace create -g $RESOURCE_GROUP -n m7-logs -l $LOCATION -o none

az monitor app-insights component create -a m7-appinsights -g $RESOURCE_GROUP -l $LOCATION \
  --workspace m7-logs --kind web --application-type web -o none

APPINSIGHTS_ID=$(az monitor app-insights component show -a m7-appinsights -g $RESOURCE_GROUP --query id -o tsv)
CONNECTION_STRING=$(az monitor app-insights component show -a m7-appinsights -g $RESOURCE_GROUP --query connectionString -o tsv)

cat > connection.json <<JSON
{
  "properties": {
    "category": "AppInsights",
    "target": "$APPINSIGHTS_ID",
    "authType": "ApiKey",
    "isSharedToAll": true,
    "credentials": { "key": "$CONNECTION_STRING" },
    "metadata": { "ApiType": "Azure", "ResourceId": "$APPINSIGHTS_ID" }
  }
}
JSON

az rest --method put \
  --url "https://management.azure.com/subscriptions/$SUBSCRIPTION_ID/resourceGroups/$RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/$FOUNDRY_ACCOUNT/projects/$FOUNDRY_PROJECT/connections/m7-appinsights?api-version=2025-06-01" \
  --body @connection.json -o none

rm connection.json
