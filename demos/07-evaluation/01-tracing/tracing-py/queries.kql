dependencies
| where timestamp > ago(1h) and cloud_RoleName == "responsesapi"
| where name startswith "invoke_agent m7-"
| extend agent = tostring(customDimensions["gen_ai.agent.name"])
| summarize p50_ms = percentile(duration, 50), p95_ms = percentile(duration, 95), calls = count() by agent
| order by p95_ms desc

requests
| where timestamp > ago(1h) and cloud_RoleName == "tracing-demo"
| extend agent = tostring(customDimensions["gen_ai.agent.name"])
| summarize total = count(), failed = countif(success == false) by agent
| extend error_rate = todouble(failed) / todouble(total)
| order by error_rate desc

dependencies
| where timestamp > ago(1h) and cloud_RoleName == "responsesapi"
| where name startswith "chat" and tostring(customDimensions["gen_ai.agent.name"]) startswith "m7-"
| extend agent = tostring(customDimensions["gen_ai.agent.name"])
| summarize input_tokens = sum(tolong(customDimensions["gen_ai.usage.input_tokens"])), output_tokens = sum(tolong(customDimensions["gen_ai.usage.output_tokens"])) by agent

let wanted_trace = "<trace-id>";
union dependencies, requests, traces
| where operation_Id == wanted_trace
| project timestamp, itemType, name, role = cloud_RoleName, message, operation_ParentId, duration, success
| order by timestamp asc
