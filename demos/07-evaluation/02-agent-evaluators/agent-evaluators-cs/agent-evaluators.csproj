    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agent_trajectories.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
